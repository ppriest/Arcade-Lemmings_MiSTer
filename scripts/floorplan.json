{"groups": [
  {"name": "Main CPU 68000",  "match": "u_top\\|u_board\\|u_cpu",              "color": "#e6194b"},
  {"name": "Sound 6809",      "match": "u_top\\|u_sound\\|(u_cpu|ram_|rom_)",  "color": "#f58231"},
  {"name": "YM2151",          "match": "u_top\\|u_sound\\|u_ym",                "color": "#ffe119"},
  {"name": "M6295",           "match": "u_top\\|u_sound\\|(u_oki|u_bridge)",    "color": "#ffd8b1"},
  {"name": "Sprites",         "match": "u_top\\|u_board\\|(u_video\\|u_spr|u_list)", "color": "#42d4f4"},
  {"name": "Video mix",       "match": "u_top\\|u_board\\|u_video",            "color": "#3cb44b"},
  {"name": "Tile pixels",     "match": "u_top\\|u_board\\|u_pix1",             "color": "#aaffc3"},
  {"name": "SDRAM",           "match": "u_top\\|u_sdram|^emu\\|u_rom_loader|^emu\\|u_ldr_ddram", "color": "#4363d8"},
  {"name": "Work RAM",        "match": "u_top\\|u_board\\|u_wram",             "color": "#911eb4"},
  {"name": "VRAM",            "match": "u_top\\|u_board\\|u_vram",             "color": "#f032e6"},
  {"name": "Palette",         "match": "u_top\\|u_board\\|u_pal_",             "color": "#fabed4"},
  {"name": "DECO 146",        "match": "u_top\\|u_board\\|u_deco",             "color": "#000075"},
  {"name": "Core other",      "match": "^emu\\|u_top",                         "color": "#bfef45"},
  {"name": "CRT V-Size",      "match": "u_crt_vsize",                          "color": "#9a6324"},
  {"name": "CRT Adjust",      "match": "u_crt_adjust",                         "color": "#dcbeff"},
  {"name": "Video mixer/scaler", "match": "^emu\\|(arcade_video|video_freak|screen_rotate_two)", "color": "#808000"},
  {"name": "hps_io",          "match": "^emu\\|hps_io",                        "color": "#469990"}
]}
