<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME lemmings.cpp; the layout is
         rtl/memory/lem_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME lemmings.cpp"/>
    <name>Lemmings (US prototype)</name>
    <setname>lemmings</setname>
    <rbf>Lemmings</rbf>
    <mameversion>0289</mameversion>
    <year>1991</year>
    <manufacturer>Data East USA</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Select,Hurry,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="lemmings.zip" md5="none" address="0x30000000">
        <!-- maincpu at 0x000000 -->
        <interleave output="16">
            <part crc="e9a2b439" name="lemmings.5" map="01"/>
            <part crc="bf52293b" name="lemmings.1" map="10"/>
        </interleave>
        <interleave output="16">
            <part crc="0e3dc0ea" name="lemmings.6" map="01"/>
            <part crc="0cf3d7ce" name="lemmings.2" map="10"/>
        </interleave>
        <interleave output="16">
            <part crc="d020219c" name="lemmings.7" map="01"/>
            <part crc="c635494a" name="lemmings.3" map="10"/>
        </interleave>
        <interleave output="16">
            <part crc="9166ce09" name="lemmings.8" map="01"/>
            <part crc="aa845488" name="lemmings.4" map="10"/>
        </interleave>
        <!-- sprites1 at 0x100000: planes of MAME bytes 3, 2, 1, 0 -->
        <part crc="e06442f5" name="lemmings.9"/>
        <part crc="36398848" name="lemmings.10"/>
        <part crc="b46a54e5" name="lemmings.11"/>
        <part repeat="0x10000">00</part>
        <!-- sprites2 at 0x140000: planes of MAME bytes 3, 2, 1, 0 -->
        <part crc="dc9047ff" name="lemmings.12"/>
        <part crc="7cc15491" name="lemmings.13"/>
        <part crc="c162788f" name="lemmings.14"/>
        <part repeat="0x10000">00</part>
        <!-- audiocpu at 0x180000 -->
        <part crc="f0b24a35" name="lemmings.15"/>
        <!-- oki at 0x190000 -->
        <part crc="f747847c" name="lemmings.16"/>
        <part repeat="0x20000">00</part>
        <part repeat="0x30000">00</part>
        <!-- pixel layer at 0x200000, zeroed -->
        <part repeat="0x80000">00</part>
    </rom>

    <switches default="FF,FF">
        <dip name="Credits for 1 Player" bits="0,1" ids="4,3,2,1"/>
        <dip name="Credits for 2 Player" bits="2,3" ids="4,3,2,1"/>
        <dip name="Credits for Continue" bits="4,5" ids="4,3,2,1"/>
        <dip name="Unknown" bits="6,6" ids="On,Off"/>
        <dip name="Free Play" bits="7,7" ids="On,Off"/>
        <dip name="Coin A" bits="8,10" ids="1 Coin/8 Credits,1 Coin/7 Credits,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="11,13" ids="1 Coin/8 Credits,1 Coin/7 Credits,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
    </switches>
</misterromdescription>
