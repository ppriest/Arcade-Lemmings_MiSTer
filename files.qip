set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/board_cpu.sv
# DECO 146 (rtl/protection/PROVENANCE.md)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/protection/lem_deco146.sv
# jtframe object drawing (rtl/PROVENANCE.md)
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_sh.v
